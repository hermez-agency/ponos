[Unit]
Description=ponos — the daemon: a place frees, the next ready ticket starts
Documentation=https://github.com/hermez-agency/ponos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@BIN@ daemon

# Always: the daemon is what takes tickets, and a machine where it died takes
# none. It restarts itself on a new version by `exec`, which systemd does not
# even see.
Restart=always
RestartSec=5

# Only the daemon itself is stopped with the unit: the Claude sessions it
# started are not its children (see tether.py) and must outlive a restart — the
# daemon that comes back adopts them. Without this line, `systemctl restart`
# would kill an hour of work in every session in flight.
KillMode=process
# A stop waits for the work a restart cannot carry on — a push, a merge — for
# up to a minute (see scheduler.py), under systemd's own limit.
TimeoutStopSec=90

# A service's PATH is not a login shell's: without this line, neither claude,
# nor gh, nor node would be found.
Environment=PATH=@PATH@
Environment=PYTHONUNBUFFERED=1

# The sessions are in this unit's group, and five of them at once took the
# desktop down with them on 2 November 2026: nice 0, the same rank as the
# browser they drive. They run in the background instead — a lower CPU weight
# than the desktop's 100, disk access only when nobody else wants it, and
# memory reclaimed from them past 60% of the machine's (19.6 GB and 7.4 GB of
# swap on 24 October, on 30 GB), long before the OOM killer picks a victim.
Nice=10
CPUWeight=20
IOSchedulingClass=idle
MemoryHigh=60%

[Install]
WantedBy=default.target
