# Never installed by this version, and kept for one reason: a Ponos from
# before the daemon writes this file when it installs the update that brings
# the daemon, and fails the update if it is missing. The daemon, once started,
# disables and removes the timer it wrote (systemd.migrate).
[Unit]
Description=ponos — the timer of the passes, replaced by ponos.service

[Timer]
OnActiveSec=@INTERVAL@s
OnBootSec=@INTERVAL@s
OnUnitActiveSec=@INTERVAL@s
AccuracySec=@ACCURACY@
Persistent=true
Unit=ponos.service

[Install]
WantedBy=timers.target
