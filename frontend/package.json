{
  "name": "ponos-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The ponos web console: React, Vite and shadcn/ui, built into the package the Python server serves.",
  "homepage": "https://the-ponos.app",
  "author": {
    "name": "Hermez",
    "url": "https://hermez.dev"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "PONOS_ORIGIN=http://127.0.0.1:8791 vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --workers=2",
    "test": "node --test src/lib/*.test.ts",
    "types": "python3 ../scripts/openapi.py | openapi-typescript -o src/lib/api-types.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-router": "^1.170.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.59.0",
    "react": "~19.2.9",
    "react-data-form": "^0.3.1",
    "react-dom": "~19.2.9",
    "react-mini-i18n": "^0.1.0",
    "react-resource-view": "^1.2.0",
    "resource-registry": "^0.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4"
  }
}
