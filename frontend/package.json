{
  "name": "ponos-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The ponos web console: React, Vite and shadcn/ui, built into the package the Python server serves.",
  "homepage": "https://the-ponos.app",
  "author": {
    "name": "Hermez",
    "url": "https://hermez.dev"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "PONOS_ORIGIN=http://127.0.0.1:8791 vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "lint:hooks": "oxlint --deny-warnings src e2e",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --workers=2",
    "test": "node --test src/lib/*.test.ts",
    "test:components": "vitest run",
    "types": "python3 ../scripts/openapi.py | node --import ./scripts/typescript-5.mjs node_modules/openapi-typescript/bin/cli.js -o src/lib/api-types.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.22.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/ai": "^1.0.1",
    "@tanstack/ai-react": "^1.0.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "openapi-fetch": "^0.17.0",
    "react": "~19.3.1",
    "react-data-form": "^0.4.0",
    "react-dom": "~19.3.1",
    "react-mini-i18n": "^0.2.1",
    "react-resource-view": "^1.2.2",
    "resource-registry": "^0.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.91.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-5": "npm:typescript@~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "^0.19.1"
    },
    "@redocly/openapi-core": {
      "minimatch": "^11.0.1"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
