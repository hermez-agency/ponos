#!/usr/bin/env bash
# Generated by install.sh — runs ponos from its install directory.
set -euo pipefail

# `@APP_DIR@` is a link to the version in use, which an update moves in one
# step. Resolved here, once: every module this process imports comes from the
# version it started on, even if the link moves while it runs.
APP_DIR="$(cd -P "@APP_DIR@" && pwd)"
export PYTHONPATH="$APP_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1

# The version's own environment (see environment.py), and the machine's Python
# while it has none: a version installed by an update from before environments
# gets one on its next pass, and runs as it always has until then.
PYTHON="@PYTHON@"
[ -x "$APP_DIR/.venv/bin/python" ] && PYTHON="$APP_DIR/.venv/bin/python"

exec "$PYTHON" -m ponos "$@"
